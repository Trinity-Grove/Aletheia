# Aletheia Local Development Environment Variables
# WARNING: These credentials and settings are strictly for local development and tests.
# NEVER reuse these values in production or any shared environment.

NODE_ENV=development
PORT=3001
WEB_PORT=3000

# PostgreSQL 17
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=aletheia_dev_secret
POSTGRES_DB=aletheia
DATABASE_URL=postgresql://aletheia:aletheia_dev_secret@127.0.0.1:5432/aletheia?schema=public
