generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Reserved for a transactional outbox pattern (reliable domain event
/// delivery). No application code writes to or reads from this table yet —
/// see https://github.com/Trinity-Grove/Aletheia/issues/47 for the decision
/// to either wire it up or remove it.
model OutboxMessage {
  id             String    @id @db.Uuid
  eventType      String    @map("event_type")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  attempts       Int       @default(0)
  idempotencyKey String    @unique @map("idempotency_key")

  @@map("outbox_messages")
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  email                   String                    @unique
  passwordHash            String                    @map("password_hash")
  fullName                String                    @map("full_name")
  emailVerifiedAt         DateTime?                 @map("email_verified_at") @db.Timestamptz
  mfaEnabled              Boolean                   @default(false) @map("mfa_enabled")
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz
  memberships             FamilyMember[]
  notifications           NotificationItem[]
  exportJobs              DataExportJob[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogEntries         AccountAuditLogEntry[]
  mfaSecret               MfaSecret?
  mfaRecoveryCodes        MfaRecoveryCode[]
  mfaSetupChallenges      MfaSetupChallenge[]
  mfaLoginChallenges      MfaLoginChallenge[]

  @@map("users")
}

enum AccountAuditEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  EMAIL_CHANGED
  EMAIL_VERIFIED
  REFRESH_TOKEN_REUSE_DETECTED
  MFA_ENABLED
  MFA_DISABLED
  MFA_CHALLENGE_FAILED

  @@map("account_audit_event_types")
}

model AccountAuditLogEntry {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  eventType AccountAuditEventType @map("event_type")
  metadata  Json?
  createdAt DateTime              @default(now()) @map("created_at") @db.Timestamptz
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("account_audit_log_entries")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model MfaSecret {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  encryptedSecret String   @map("encrypted_secret")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_secrets")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model MfaSetupChallenge {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  encryptedSecret    String   @map("encrypted_secret")
  recoveryCodeHashes String[] @map("recovery_code_hashes")
  expiresAt          DateTime @map("expires_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_setup_challenges")
}

model MfaLoginChallenge {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  tokenHash    String   @unique @map("token_hash")
  attemptCount Int      @default(0) @map("attempt_count")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("mfa_login_challenges")
}

model Family {
  id               String             @id @default(uuid()) @db.Uuid
  name             String
  countryCode      String             @map("country_code")
  stateProvince    String?            @map("state_province")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  members          FamilyMember[]
  invitations      FamilyInvitation[]
  learners         Learner[]
  dailyDevotionals   DailyDevotional[]
  prayerRequests     PrayerRequest[]
  academicYears      AcademicYear[]
  subjects           Subject[]
  curriculumPlans    LearnerCurriculumPlan[]
  learningObjectives LearningObjective[]
  lessonPlans        LessonPlan[]
  scheduleSlots      WeeklyScheduleSlot[]
  learningRecords    LearningRecord[]
  portfolioItems     PortfolioItem[]
  attendanceRecords  AttendanceRecord[]
  complianceRequirements ComplianceRequirement[]
  officialReports    OfficialReport[]
  settings           FamilySettings?
  notifications      NotificationItem[]
  exportJobs         DataExportJob[]

  @@map("families")
}

enum EducationalStage {
  EARLY_YEARS
  PRIMARY_GRAMMAR
  MIDDLE_LOGIC
  HIGH_RHETORIC
  OTHER

  @@map("educational_stages")
}

enum PrayerType {
  PETITION
  GRATITUDE

  @@map("prayer_types")
}

model Learner {
  id             String           @id @default(uuid()) @db.Uuid
  familyId       String           @map("family_id") @db.Uuid
  firstName      String           @map("first_name")
  lastName       String?          @map("last_name")
  preferredName  String?          @map("preferred_name")
  birthDate      DateTime         @map("birth_date") @db.Date
  stage          EducationalStage @default(PRIMARY_GRAMMAR)
  customGrade    String?          @map("custom_grade")
  avatarColor    String?          @map("avatar_color")
  specialNeeds   String?          @map("special_needs")
  notes          String?
  archivedAt     DateTime?        @map("archived_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  family             Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  prayerRequests     PrayerRequest[]
  curriculumPlans    LearnerCurriculumPlan[]
  learningObjectives LearningObjective[]
  lessonPlans        LessonPlanLearner[]
  scheduleSlots      WeeklyScheduleSlot[]
  learningRecords    LearningRecord[]
  portfolioItems     PortfolioItem[]
  attendanceRecords  AttendanceRecord[]
  complianceRequirements ComplianceRequirement[]
  officialReports    OfficialReport[]

  @@index([familyId])
  @@index([familyId, archivedAt])
  @@map("learners")
}

model FamilyMember {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId], name: "family_members_family_user_unique")
  @@index([userId])
  @@index([familyId])
  @@map("family_members")
}

model FamilyInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  email      String
  role       String
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([email])
  @@index([tokenHash])
  @@map("family_invitations")
}

model DailyDevotional {
  id                   String    @id @default(uuid()) @db.Uuid
  familyId             String    @map("family_id") @db.Uuid
  date                 DateTime  @db.Date
  bibleReference       String    @map("bible_reference")
  bibleVersionId       String?   @map("bible_version_id")
  passageText          String?   @map("passage_text")
  reflection           String?
  memoryVerse          String?   @map("memory_verse")
  hymnOrSong           String?   @map("hymn_or_song")
  discussionQuestions  String?   @map("discussion_questions")
  practicalApplication String?   @map("practical_application")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, date])
  @@index([familyId])
  @@map("daily_devotionals")
}

model PrayerRequest {
  id           String     @id @default(uuid()) @db.Uuid
  familyId     String     @map("family_id") @db.Uuid
  learnerId    String?    @map("learner_id") @db.Uuid
  type         PrayerType @default(PETITION)
  title        String
  description  String?
  isAnswered   Boolean    @default(false) @map("is_answered")
  answeredAt   DateTime?  @map("answered_at") @db.Timestamptz
  answeredNote String?    @map("answered_note")
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  family  Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner Learner? @relation(fields: [learnerId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([familyId, isAnswered])
  @@map("prayer_requests")
}

enum PedagogicalFramework {
  CLASSICAL_TRIVIUM
  CHARLOTTE_MASON
  TRADITIONAL
  UNIT_STUDIES
  CUSTOM

  @@map("pedagogical_frameworks")
}

enum ObjectiveStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED

  @@map("objective_statuses")
}

model AcademicYear {
  id         String                  @id @default(uuid()) @db.Uuid
  familyId   String                  @map("family_id") @db.Uuid
  year       Int
  title      String
  startDate  DateTime?               @map("start_date") @db.Date
  endDate    DateTime?               @map("end_date") @db.Date
  isCurrent  Boolean                 @default(false) @map("is_current")
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  family        Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  plans         LearnerCurriculumPlan[]
  objectives    LearningObjective[]
  lessonPlans   LessonPlan[]
  scheduleSlots WeeklyScheduleSlot[]
  learningRecords LearningRecord[]
  portfolioItems  PortfolioItem[]
  attendanceRecords AttendanceRecord[]
  complianceRequirements ComplianceRequirement[]
  officialReports OfficialReport[]

  @@unique([familyId, year])
  @@index([familyId])
  @@map("academic_years")
}

model Subject {
  id          String              @id @default(uuid()) @db.Uuid
  familyId    String              @map("family_id") @db.Uuid
  name        String
  color       String?
  icon        String?
  description String?
  archivedAt  DateTime?           @map("archived_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  family        Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  objectives    LearningObjective[]
  lessonPlans   LessonPlan[]
  scheduleSlots WeeklyScheduleSlot[]
  learningRecords LearningRecord[]
  portfolioItems  PortfolioItem[]

  @@unique([familyId, name])
  @@index([familyId])
  @@map("subjects")
}

model LearnerCurriculumPlan {
  id                   String               @id @default(uuid()) @db.Uuid
  familyId             String               @map("family_id") @db.Uuid
  learnerId            String               @map("learner_id") @db.Uuid
  academicYearId       String               @map("academic_year_id") @db.Uuid
  pedagogicalFramework PedagogicalFramework @default(CUSTOM) @map("pedagogical_framework")
  notes                String?
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  family               Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner              Learner              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  academicYear         AcademicYear         @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([familyId, learnerId, academicYearId])
  @@index([familyId])
  @@map("learner_curriculum_plans")
}

model LearningObjective {
  id             String          @id @default(uuid()) @db.Uuid
  familyId       String          @map("family_id") @db.Uuid
  learnerId      String          @map("learner_id") @db.Uuid
  subjectId      String          @map("subject_id") @db.Uuid
  academicYearId String          @map("academic_year_id") @db.Uuid
  title          String
  description    String?
  status         ObjectiveStatus @default(NOT_STARTED)
  targetDate     DateTime?       @map("target_date") @db.Date
  achievedAt     DateTime?       @map("achieved_at") @db.Timestamptz
  order          Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  family         Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner        Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject        Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear          @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  lessonPlans    LessonPlanObjective[]
  learningRecords LearningRecordObjective[]

  @@index([familyId, learnerId, academicYearId])
  @@index([familyId, subjectId])
  @@map("learning_objectives")
}

enum LessonStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED

  @@map("lesson_statuses")
}

model LessonPlan {
  id                    String                @id @default(uuid()) @db.Uuid
  familyId              String                @map("family_id") @db.Uuid
  academicYearId        String?               @map("academic_year_id") @db.Uuid
  subjectId             String                @map("subject_id") @db.Uuid
  title                 String
  description           String?
  date                  DateTime              @db.Date
  startTime             String?               @map("start_time")
  endTime               String?               @map("end_time")
  durationMinutes       Int?                  @map("duration_minutes")
  actualDurationMinutes Int?                  @map("actual_duration_minutes")
  status                LessonStatus          @default(PLANNED)
  materials             String?
  homework              String?
  notes                 String?
  completedAt           DateTime?             @map("completed_at") @db.Timestamptz
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  family                Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  academicYear          AcademicYear?         @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subject               Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  learners              LessonPlanLearner[]
  objectives            LessonPlanObjective[]
  learningRecords       LearningRecord[]

  @@index([familyId])
  @@index([familyId, date])
  @@index([familyId, subjectId])
  @@index([familyId, status])
  @@map("lesson_plans")
}

model LessonPlanLearner {
  id           String     @id @default(uuid()) @db.Uuid
  lessonPlanId String     @map("lesson_plan_id") @db.Uuid
  learnerId    String     @map("learner_id") @db.Uuid
  notes        String?
  completed    Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  learner      Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, learnerId])
  @@index([learnerId])
  @@map("lesson_plan_learners")
}

model LessonPlanObjective {
  id           String            @id @default(uuid()) @db.Uuid
  lessonPlanId String            @map("lesson_plan_id") @db.Uuid
  objectiveId  String            @map("objective_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  lessonPlan   LessonPlan        @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  objective    LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, objectiveId])
  @@index([objectiveId])
  @@map("lesson_plan_objectives")
}

model WeeklyScheduleSlot {
  id             String        @id @default(uuid()) @db.Uuid
  familyId       String        @map("family_id") @db.Uuid
  academicYearId String?       @map("academic_year_id") @db.Uuid
  subjectId      String?       @map("subject_id") @db.Uuid
  learnerId      String?       @map("learner_id") @db.Uuid
  dayOfWeek      Int           @map("day_of_week")
  startTime      String        @map("start_time")
  endTime        String        @map("end_time")
  title          String
  description    String?
  location       String?
  color          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subject        Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  learner        Learner?      @relation(fields: [learnerId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([familyId, dayOfWeek])
  @@index([familyId, learnerId])
  @@map("weekly_schedule_slots")
}

enum MasteryLevel {
  NOT_STARTED
  EXPOSURE
  DEVELOPING
  WITH_ASSISTANCE
  AUTONOMOUS
  MASTERED

  @@map("mastery_levels")
}

enum AssessmentMethod {
  OBSERVATION
  NARRATION
  EXERCISE
  WRITING
  PROJECT
  EXPERIMENT
  PRESENTATION
  TEST
  SELF_ASSESSMENT
  PRACTICAL_DEMONSTRATION

  @@map("assessment_methods")
}

enum EvidenceType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LINK
  TEXT
  CERTIFICATE

  @@map("evidence_types")
}

enum LearningRecordType {
  PLANNED_LESSON
  SPONTANEOUS_EXPERIENCE
  PROJECT_WORK
  READING_LOG
  HABIT_PRACTICE

  @@map("learning_record_types")
}

model LearningRecord {
  id                   String                  @id @default(uuid()) @db.Uuid
  familyId             String                  @map("family_id") @db.Uuid
  learnerId            String                  @map("learner_id") @db.Uuid
  subjectId            String?                 @map("subject_id") @db.Uuid
  academicYearId       String?                 @map("academic_year_id") @db.Uuid
  lessonPlanId         String?                 @map("lesson_plan_id") @db.Uuid
  type                 LearningRecordType      @default(PLANNED_LESSON)
  title                String
  description          String?
  date                 DateTime                @db.Date
  durationMinutes      Int?                    @map("duration_minutes")
  masteryLevel         MasteryLevel            @default(DEVELOPING) @map("mastery_level")
  assessmentMethod     AssessmentMethod        @default(OBSERVATION) @map("assessment_method")
  strengths            String?
  areasForGrowth       String?                 @map("areas_for_growth")
  characterHabitGrowth String?                 @map("character_habit_growth")
  notes                String?
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  family               Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner              Learner                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  subject              Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  academicYear         AcademicYear?           @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  lessonPlan           LessonPlan?             @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)
  objectives           LearningRecordObjective[]
  portfolioItems       PortfolioItem[]

  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([familyId, date])
  @@index([familyId, subjectId])
  @@index([familyId, type])
  @@map("learning_records")
}

model LearningRecordObjective {
  id               String            @id @default(uuid()) @db.Uuid
  learningRecordId String            @map("learning_record_id") @db.Uuid
  objectiveId      String            @map("objective_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz

  learningRecord   LearningRecord    @relation(fields: [learningRecordId], references: [id], onDelete: Cascade)
  objective        LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([learningRecordId, objectiveId])
  @@index([objectiveId])
  @@map("learning_record_objectives")
}

model PortfolioItem {
  id               String          @id @default(uuid()) @db.Uuid
  familyId         String          @map("family_id") @db.Uuid
  learnerId        String          @map("learner_id") @db.Uuid
  learningRecordId String?         @map("learning_record_id") @db.Uuid
  academicYearId   String?         @map("academic_year_id") @db.Uuid
  subjectId        String?         @map("subject_id") @db.Uuid
  title            String
  description      String?
  type             EvidenceType
  fileUrl          String?         @map("file_url")
  textContent      String?         @map("text_content")
  mimeType         String?         @map("mime_type")
  fileSizeBytes    Int?            @map("file_size_bytes")
  capturedAt       DateTime?       @map("captured_at") @db.Date
  isHighlight      Boolean         @default(false) @map("is_highlight")
  tags             String[]        @default([])
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  family           Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner          Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  learningRecord   LearningRecord? @relation(fields: [learningRecordId], references: [id], onDelete: SetNull)
  academicYear     AcademicYear?   @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  subject          Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([familyId, learningRecordId])
  @@index([familyId, subjectId])
  @@index([familyId, isHighlight])
  @@map("portfolio_items")
}

enum AttendanceStatus {
  PRESENT
  EXCUSED_ABSENCE
  UNEXCUSED_ABSENCE
  HOLIDAY
  FIELD_TRIP
  SICK

  @@map("attendance_statuses")
}

enum GradingScale {
  MASTERY_QUALITATIVE
  LETTER_A_F
  NUMERIC_0_10
  NUMERIC_0_100
  NARRATIVE

  @@map("grading_scales")
}

enum ReportType {
  ATTENDANCE_SUMMARY
  ACADEMIC_TRANSCRIPT
  LEARNING_PORTFOLIO_DOSSIER
  ANNUAL_COMPLIANCE_REPORT

  @@map("report_types")
}

model AttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  familyId       String           @map("family_id") @db.Uuid
  learnerId      String           @map("learner_id") @db.Uuid
  academicYearId String?          @map("academic_year_id") @db.Uuid
  date           DateTime         @db.Date
  status         AttendanceStatus @default(PRESENT)
  hoursSpent     Float?           @map("hours_spent")
  notes          String?
  isAutoLogged   Boolean          @default(false) @map("is_auto_logged")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  family         Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner        Learner          @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear?    @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@unique([familyId, learnerId, date])
  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([familyId, date])
  @@index([familyId, academicYearId])
  @@map("attendance_records")
}

model ComplianceRequirement {
  id                    String        @id @default(uuid()) @db.Uuid
  familyId              String        @map("family_id") @db.Uuid
  academicYearId        String        @map("academic_year_id") @db.Uuid
  learnerId             String?       @map("learner_id") @db.Uuid
  jurisdiction          String?
  minInstructionalDays  Int?          @map("min_instructional_days")
  minInstructionalHours Float?        @map("min_instructional_hours")
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  academicYear          AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  learner               Learner?      @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([familyId, academicYearId, learnerId])
  @@index([familyId])
  @@index([familyId, academicYearId])
  @@map("compliance_requirements")
}

model OfficialReport {
  id             String       @id @default(uuid()) @db.Uuid
  familyId       String       @map("family_id") @db.Uuid
  learnerId      String       @map("learner_id") @db.Uuid
  academicYearId String?      @map("academic_year_id") @db.Uuid
  type           ReportType
  title          String
  gradingScale   GradingScale @default(MASTERY_QUALITATIVE) @map("grading_scale")
  content        Json
  generatedAt    DateTime     @default(now()) @map("generated_at") @db.Timestamptz
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner        Learner       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([familyId, academicYearId])
  @@index([familyId, type])
  @@map("official_reports")
}

enum NotificationType {
  DEVOTIONAL_REMINDER
  DAILY_SCHEDULE_REMINDER
  ATTENDANCE_MISSING_REMINDER
  PRAYER_ANSWERED_ALERT
  SYSTEM_NOTICE

  @@map("notification_types")
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("export_statuses")
}

model FamilySettings {
  id                        String       @id @default(uuid()) @db.Uuid
  familyId                  String       @unique @map("family_id") @db.Uuid
  homeschoolName            String?      @map("homeschool_name")
  defaultGradingScale       GradingScale @default(MASTERY_QUALITATIVE) @map("default_grading_scale")
  timezone                  String       @default("America/Sao_Paulo")
  language                  String       @default("pt-BR")
  devotionalReminderTime    String?      @map("devotional_reminder_time")
  dailyScheduleReminderTime String?      @map("daily_schedule_reminder_time")
  attendanceReminderEnabled Boolean      @default(true) @map("attendance_reminder_enabled")
  emailNotificationsEnabled Boolean      @default(true) @map("email_notifications_enabled")
  inAppNotificationsEnabled Boolean      @default(true) @map("in_app_notifications_enabled")
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  family                    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("family_settings")
}

model NotificationItem {
  id        String           @id @default(uuid()) @db.Uuid
  familyId  String           @map("family_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  linkUrl   String?          @map("link_url")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  family    Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([familyId, userId])
  @@index([familyId, userId, isRead])
  @@map("notification_items")
}

model DataExportJob {
  id            String       @id @default(uuid()) @db.Uuid
  familyId      String       @map("family_id") @db.Uuid
  requestedById String       @map("requested_by_id") @db.Uuid
  status        ExportStatus @default(PENDING)
  downloadUrl   String?      @map("download_url")
  fileSizeBytes Int?         @map("file_size_bytes")
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz
  errorReason   String?      @map("error_reason")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  family        Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  requestedBy   User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([familyId, status])
  @@map("data_export_jobs")
}



