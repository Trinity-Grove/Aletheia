// --- Data-driven curriculum foundation (Aletheia issue #96, Fase 0) ---
//
// Generic Definition/Version pattern: platform-level content (learning
// domains, competencies, pedagogical models, and -- later -- theological
// perspectives, activities, rubrics, curriculum packs) is modeled as
// versioned data rows instead of enums/switch-cases baked into application
// code. Every definition table shares the same identity/versioning shape
// (code, version, status, schema_version, created_at, published_at,
// deprecated_at) plus a `metadata` JSONB column for extensible, non-critical
// properties. Relational columns are used for identity/relationship/
// versioning; JSONB is only for extensible properties -- never a single
// untyped blob.
//
// This coexists with the pre-existing `PedagogicalFramework` enum and the
// hardcoded switch-case in CurriculumTemplateEngine (strangler-fig). Neither
// is removed in this phase; that cutover is a separate, human-approved PR.
enum DefinitionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  ARCHIVED

  @@map("definition_statuses")
}

model LearningDomain {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  name          String
  description   String?
  parentId      String?          @map("parent_id") @db.Uuid
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  parent          LearningDomain?              @relation("LearningDomainHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        LearningDomain[]             @relation("LearningDomainHierarchy")
  competencies    CompetencyDefinition[]
  learningPaths   LearningPath[]
  curriculumLinks CurriculumDefinitionDomain[]

  @@unique([code, version])
  @@index([code])
  @@index([parentId])
  @@index([status])
  @@map("learning_domains")
}

model CompetencyDefinition {
  achievements LearnerCompetencyAchievement[]
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  domainId      String           @map("domain_id") @db.Uuid
  pathId        String?          @map("path_id") @db.Uuid
  title         String
  level         Int?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  domain                  LearningDomain                   @relation(fields: [domainId], references: [id], onDelete: Restrict)
  path                    LearningPath?                    @relation(fields: [pathId], references: [id], onDelete: SetNull)
  skills                  SkillDefinition[]
  rubrics                 RubricDefinition[]
  curriculumLinks         CurriculumDefinitionCompetency[]
  activityLinks           ActivityDefinitionCompetency[]
  progressionPolicies     ProgressionPolicy[]
  evidenceSubmissionLinks EvidenceSubmissionCompetency[]
  learnerTrackings        LearnerCompetencyTracking[]

  @@unique([code, version])
  @@index([code])
  @@index([domainId])
  @@index([pathId])
  @@index([status])
  @@map("competency_definitions")
}

// Learning path: belongs to a domain, can hold many competencies (issue
// #96 section 4). Same Definition/Version shape as everything else here.
model LearningPath {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  domainId      String           @map("domain_id") @db.Uuid
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  domain       LearningDomain         @relation(fields: [domainId], references: [id], onDelete: Restrict)
  competencies CompetencyDefinition[]

  @@unique([code, version])
  @@index([code])
  @@index([domainId])
  @@index([status])
  @@map("learning_paths")
}

// Skill definition: belongs to a competency (issue #96 section 6).
// `metadata.dependencies` holds other skill codes rather than a relational
// join table for this first slice -- kept extensible/JSONB per the
// "relational for identity, JSONB for extensible properties" rule since
// skill-to-skill prerequisite graphs aren't load-bearing for anything yet.
model SkillDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  competencyId  String           @map("competency_id") @db.Uuid
  title         String
  order         Int              @default(0)
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  competency CompetencyDefinition @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([code, version])
  @@index([code])
  @@index([competencyId])
  @@index([status])
  @@map("skill_definitions")
}

// Rubric definition (issue #96 section 10). Optionally scoped to one
// competency (nullable FK -- a rubric can also be reusable across several,
// referenced generically rather than owned by exactly one). Criteria are a
// real child table, not JSON, so weights and scales are queryable/
// joinable per section 30's JSONB-discipline rule; `metadata` carries the
// extensible, non-load-bearing bits (which assessment modes apply --
// binary/quantitative/qualitative/self/parent/mentor/competency-based --
// as free-form strings, not a closed enum, so a new mode is a data value,
// not a migration).
model RubricDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  competencyId  String?          @map("competency_id") @db.Uuid
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  competency        CompetencyDefinition?        @relation(fields: [competencyId], references: [id], onDelete: SetNull)
  criteria          RubricCriterion[]
  curriculumLinks   CurriculumDefinitionRubric[]
  assessmentResults AssessmentResult[]

  @@unique([code, version])
  @@index([code])
  @@index([competencyId])
  @@index([status])
  @@map("rubric_definitions")
}

model RubricCriterion {
  id        String   @id @default(uuid()) @db.Uuid
  rubricId  String   @map("rubric_id") @db.Uuid
  code      String
  label     String
  weight    Float    @default(1)
  order     Int      @default(0)
  scaleMin  Int      @default(0) @map("scale_min")
  scaleMax  Int      @default(4) @map("scale_max")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rubric           RubricDefinition        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  assessmentScores AssessmentResultScore[]

  @@unique([rubricId, code])
  @@index([rubricId])
  @@map("rubric_criteria")
}

// Pedagogical model definition (framework), same Definition/Version shape.
// `metadata.subjects` holds an array shaped like the pre-existing
// TemplateSubjectDefinition (name, color, icon, description,
// starterObjectives) -- seeded from the content already written in
// CurriculumTemplateEngine so nothing is rewritten from scratch. Each row
// includes both the framework's own subjects and the shared cross-cutting
// ones (Artes/Ofícios/Vocação, Fé e Teologia, Vida Prática), exactly
// mirroring what the old switch-case returns for that framework.
model PedagogicalModelDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  curricula    CurriculumDefinition[]
  learnerPlans LearnerCurriculumPlan[]

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@map("pedagogical_model_definitions")
}

// Evidence type catalog (issue #96 section 9): the kinds of evidence a
// portfolio item/activity submission can be (text, photo, video, audio,
// file, certificate, observation) as data rows instead of a closed enum,
// so a new evidence type is a data write, not a migration. The base 7 are
// seeded (see evidence-type-definition.seed-data.ts in apps/api), but
// nothing about this table hardcodes that list -- new PUBLISHED rows are
// picked up generically by anything that reads from it.
model EvidenceTypeDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  activityLinks       ActivityDefinitionEvidenceType[]
  evidenceSubmissions EvidenceSubmission[]

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@map("evidence_type_definitions")
}

// Curriculum definition: the top-level composition (issue #96 sections 3
// and 23) -- a named, versioned bundle that references a pedagogical
// model and a set of learning domains/competencies/rubrics. This is what
// a family's future PedagogicalProfile (Fase 1, not this slice) will
// eventually point to, so its shape is kept deliberately free of
// family-specific fields (no familyId, no per-family overrides here --
// those belong on the profile, not the shared definition).
//
// Domains/competencies/rubrics are real join tables, not JSON arrays of
// IDs, so references are FK-checked and queryable (section 30/31). There
// is deliberately no "activities" reference yet -- no ActivityDefinition
// table exists (issue #96 section 7 is a later slice), so wiring that in
// now would mean referencing something that doesn't exist. "Referencia
// avaliações" is covered by the rubrics join below.
model CurriculumDefinition {
  achievements LearnerCompetencyAchievement[]
  id                           String           @id @default(uuid()) @db.Uuid
  code                         String
  version                      Int              @default(1)
  status                       DefinitionStatus @default(DRAFT)
  schemaVersion                String           @default("1.0.0") @map("schema_version")
  name                         String
  description                  String?
  pedagogicalModelDefinitionId String?          @map("pedagogical_model_definition_id") @db.Uuid
  metadata                     Json             @default("{}")
  createdAt                    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt                  DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt                 DateTime?        @map("deprecated_at") @db.Timestamptz

  pedagogicalModel    PedagogicalModelDefinition?      @relation(fields: [pedagogicalModelDefinitionId], references: [id], onDelete: SetNull)
  domains             CurriculumDefinitionDomain[]
  competencies        CurriculumDefinitionCompetency[]
  rubrics             CurriculumDefinitionRubric[]
  activities          CurriculumDefinitionActivity[]
  progressionPolicies ProgressionPolicy[]
  learnerTrackings    LearnerCompetencyTracking[]

  @@unique([code, version])
  @@index([code])
  @@index([pedagogicalModelDefinitionId])
  @@index([status])
  @@map("curriculum_definitions")
}

model CurriculumDefinitionDomain {
  id                     String   @id @default(uuid()) @db.Uuid
  curriculumDefinitionId String   @map("curriculum_definition_id") @db.Uuid
  domainId               String   @map("domain_id") @db.Uuid
  required               Boolean  @default(true)
  order                  Int      @default(0)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  curriculumDefinition CurriculumDefinition @relation(fields: [curriculumDefinitionId], references: [id], onDelete: Cascade)
  domain               LearningDomain       @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@unique([curriculumDefinitionId, domainId])
  @@index([curriculumDefinitionId])
  @@index([domainId])
  @@map("curriculum_definition_domains")
}

model CurriculumDefinitionCompetency {
  id                     String   @id @default(uuid()) @db.Uuid
  curriculumDefinitionId String   @map("curriculum_definition_id") @db.Uuid
  competencyId           String   @map("competency_id") @db.Uuid
  required               Boolean  @default(true)
  order                  Int      @default(0)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  curriculumDefinition CurriculumDefinition @relation(fields: [curriculumDefinitionId], references: [id], onDelete: Cascade)
  competency           CompetencyDefinition @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([curriculumDefinitionId, competencyId])
  @@index([curriculumDefinitionId])
  @@index([competencyId])
  @@map("curriculum_definition_competencies")
}

model CurriculumDefinitionRubric {
  id                     String   @id @default(uuid()) @db.Uuid
  curriculumDefinitionId String   @map("curriculum_definition_id") @db.Uuid
  rubricId               String   @map("rubric_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  curriculumDefinition CurriculumDefinition @relation(fields: [curriculumDefinitionId], references: [id], onDelete: Cascade)
  rubric               RubricDefinition     @relation(fields: [rubricId], references: [id], onDelete: Restrict)

  @@unique([curriculumDefinitionId, rubricId])
  @@index([curriculumDefinitionId])
  @@index([rubricId])
  @@map("curriculum_definition_rubrics")
}

model CurriculumDefinitionActivity {
  id                     String   @id @default(uuid()) @db.Uuid
  curriculumDefinitionId String   @map("curriculum_definition_id") @db.Uuid
  activityId             String   @map("activity_id") @db.Uuid
  required               Boolean  @default(true)
  order                  Int      @default(0)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  curriculumDefinition CurriculumDefinition @relation(fields: [curriculumDefinitionId], references: [id], onDelete: Cascade)
  activity             ActivityDefinition   @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([curriculumDefinitionId, activityId])
  @@index([curriculumDefinitionId])
  @@index([activityId])
  @@map("curriculum_definition_activities")
}

// Activity definition (issue #96 section 7): a reusable, versioned
// learning activity -- not owned by any one curriculum. Competencies it
// validates are a real join table (ActivityDefinitionCompetency), same
// discipline as CurriculumDefinition's joins -- not a JSON array of IDs.
// Required evidence is a join to the EvidenceTypeDefinition catalog
// (ActivityDefinitionEvidenceType) rather than duplicating that catalog
// here. `evidenceRequirementMode` (ANY/ALL) describes how the linked
// evidence types combine -- an activity can require *one of several*
// accepted types (ANY, e.g. "a photo OR a video") or *all* of them (ALL,
// e.g. "a video AND a mentor observation"). This is a fixed structural
// operator, not domain content, so unlike evidence types themselves it's
// safe as a small closed set rather than a free string.
model ActivityDefinition {
  id                       String           @id @default(uuid()) @db.Uuid
  code                     String
  version                  Int              @default(1)
  status                   DefinitionStatus @default(DRAFT)
  schemaVersion            String           @default("1.0.0") @map("schema_version")
  name                     String
  description              String?
  ageMin                   Int?             @map("age_min")
  ageMax                   Int?             @map("age_max")
  estimatedDurationMinutes Int?             @map("estimated_duration_minutes")
  supervisionRequired      Boolean          @default(false) @map("supervision_required")
  riskLevel                String?          @map("risk_level")
  evidenceRequirementMode  String           @default("ANY") @map("evidence_requirement_mode")
  metadata                 Json             @default("{}")
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt              DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt             DateTime?        @map("deprecated_at") @db.Timestamptz

  competencies    ActivityDefinitionCompetency[]
  evidenceTypes   ActivityDefinitionEvidenceType[]
  curriculumLinks CurriculumDefinitionActivity[]

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@map("activity_definitions")
}

model ActivityDefinitionCompetency {
  id           String   @id @default(uuid()) @db.Uuid
  activityId   String   @map("activity_id") @db.Uuid
  competencyId String   @map("competency_id") @db.Uuid
  required     Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  activity   ActivityDefinition   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  competency CompetencyDefinition @relation(fields: [competencyId], references: [id], onDelete: Restrict)

  @@unique([activityId, competencyId])
  @@index([activityId])
  @@index([competencyId])
  @@map("activity_definition_competencies")
}

model ActivityDefinitionEvidenceType {
  id             String   @id @default(uuid()) @db.Uuid
  activityId     String   @map("activity_id") @db.Uuid
  evidenceTypeId String   @map("evidence_type_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  activity     ActivityDefinition     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidenceType EvidenceTypeDefinition @relation(fields: [evidenceTypeId], references: [id], onDelete: Restrict)

  @@unique([activityId, evidenceTypeId])
  @@index([activityId])
  @@index([evidenceTypeId])
  @@map("activity_definition_evidence_types")
}

// Theological taxonomy (issue #96 section 14): a data-driven substitute
// for hardcoding denominations/doctrinal positions in enums. This PR is
// the shape only -- no real theological content (that's issue #95's
// scoped-separately content work). A tradition has many positions (plain
// FK, not a join table -- a position is a specific stance one tradition
// holds, not shared across traditions); `topic` is a free-form string
// (e.g. "soteriology", "eschatology") rather than a closed enum, so a new
// topic is a data value. Nothing here is wired into any content-tagging
// or read path yet.
model TheologicalTraditionDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  positions TheologicalPositionDefinition[]

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@map("theological_tradition_definitions")
}

model TheologicalPositionDefinition {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  // Nullable (Fase 3, issue #96 section 15): cross-cutting eschatological
  // schools of thought (premillennialism, amillennialism, preterism, ...)
  // aren't owned by one denomination/tradition, unlike most doctrinal
  // positions -- see the comment in packages/contracts/src/
  // theological-taxonomy.ts for the full reasoning.
  traditionId   String?          @map("tradition_id") @db.Uuid
  topic         String
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  tradition TheologicalTraditionDefinition? @relation(fields: [traditionId], references: [id], onDelete: Restrict)

  @@unique([code, version])
  @@index([code])
  @@index([traditionId])
  @@index([topic])
  @@index([status])
  @@map("theological_position_definitions")
}

// Per-family pedagogical profile (issue #96 section 13). References a
// PedagogicalModelDefinition by `code`, not by FK to one specific row --
// same reason CurriculumService.applyTemplate already resolves templates
// by (code, status=PUBLISHED): which version is the current PUBLISHED one
// can change over time, and a profile should track the logical model, not
// pin a row ID. secondaryModels/overrides are JSONB (extensible,
// non-relational config), per the JSONB-discipline rule.
//
// Append-only, same spirit as the platform Definition/Version pattern
// adapted for a per-family record: "upserting" a profile always INSERTs a
// new row with version = previous max + 1 for that family, never UPDATEs
// in place. The current profile is simply the highest-version row for
// that family. This satisfies "pode alterar preferências sem destruir
// histórico" and "alterações são versionadas" without a second history
// table -- nothing is ever mutated or deleted.
//
// Not wired into any read path yet -- CurriculumService.applyTemplate
// still doesn't consult this. That integration is a separate,
// human-approved step once this foundation is proven correct on its own.
model PedagogicalProfile {
  id               String   @id @default(uuid()) @db.Uuid
  familyId         String   @map("family_id") @db.Uuid
  version          Int      @default(1)
  primaryModelCode String   @map("primary_model_code")
  secondaryModels  Json     @default("[]") @map("secondary_models")
  overrides        Json     @default("{}")
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PedagogicalProfileAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([familyId, version])
  @@index([familyId])
  @@map("pedagogical_profiles")
}

// Per-family theological profile (issue #96 section 14). Same
// append-only versioning approach as PedagogicalProfile, for the same
// reasons (audit trail without a second table). `preferredTraditionCode`
// references a TheologicalTraditionDefinition by code (nullable -- a
// family may not have chosen one); `topicOverrides` is a generic
// topic -> TheologicalPositionDefinition-code map, so a family can
// override the preferred tradition's stance on individual topics without
// switching traditions wholesale.
model TheologicalProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  familyId               String   @map("family_id") @db.Uuid
  version                Int      @default(1)
  preferredTraditionCode String?  @map("preferred_tradition_code")
  topicOverrides         Json     @default("{}") @map("topic_overrides")
  createdByUserId         String?  @map("created_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User? @relation("TheologicalProfileAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([familyId, version])
  @@index([familyId])
  @@map("theological_profiles")
}

// Progression policy (issue #96 Fase 2, section 11): platform/family
// configuration, so it follows the Definition/Version pattern like every
// other catalog table -- NOT user data (contrast with EvidenceSubmission/
// AssessmentResult, a separate slice of this same Fase 2 work).
// `policyType` is a free-form string
// (e.g. "MASTERY", "HOURS", "PROJECTS", "EVIDENCE_COUNT",
// "MENTOR_APPROVAL"), not a closed enum, per this issue's own anti-
// hardcode principle -- a new progression model is a data value. `rules`
// is JSONB because its shape genuinely varies per policyType (hours
// thresholds vs. mastery levels vs. mentor-approval workflow are
// structurally different), which is exactly the "extensible, non-
// relational" case section 30 carves out for JSONB. Optionally scoped to
// one CompetencyDefinition or CurriculumDefinition (nullable FKs, SetNull
// on delete -- same choice as RubricDefinition.competencyId, since this
// is platform config, not user data whose history must never be lost).
model ProgressionPolicy {
  learnerTrackings LearnerCompetencyTracking[]
  achievements LearnerCompetencyAchievement[]
  id                     String           @id @default(uuid()) @db.Uuid
  code                   String
  version                Int              @default(1)
  status                 DefinitionStatus @default(DRAFT)
  schemaVersion          String           @default("1.0.0") @map("schema_version")
  name                   String
  description            String?
  policyType             String           @map("policy_type")
  rules                  Json             @default("{}")
  competencyDefinitionId String?          @map("competency_definition_id") @db.Uuid
  curriculumDefinitionId String?          @map("curriculum_definition_id") @db.Uuid
  metadata               Json             @default("{}")
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt            DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt           DateTime?        @map("deprecated_at") @db.Timestamptz

  competencyDefinition CompetencyDefinition? @relation(fields: [competencyDefinitionId], references: [id], onDelete: SetNull)
  curriculumDefinition CurriculumDefinition? @relation(fields: [curriculumDefinitionId], references: [id], onDelete: SetNull)

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@index([competencyDefinitionId])
  @@index([curriculumDefinitionId])
  @@map("progression_policies")
}

// Evidence submission (issue #96 Fase 2, section 9): a learner's actual
// evidence record -- USER DATA, not a Definition/Version catalog table
// (contrast with EvidenceTypeDefinition, which is the platform's catalog
// of *kinds* of evidence). Deliberately NOT wired into LearningObjective/
// LearningRecord -- whether evidence submissions eventually unify with
// those is a human-approved product decision, out of scope here.
//
// Content reuses the exact shape PortfolioItem already established
// (fileUrl/textContent/mimeType/fileSizeBytes/storageKey/checksumSha256)
// rather than inventing new file handling.
//
// Multi-competency support ("uma evidência pode validar várias
// competências") is a real join table (EvidenceSubmissionCompetency),
// not an array column, per section 30 -- and critically, that join table
// snapshots the *specific competency version row* (by FK, which is
// immutable once created under the Definition/Version pattern) plus a
// denormalized `competencyVersion` int for cheap readability. A later
// competency version bump creates a *new* CompetencyDefinition row; the
// join keeps pointing at the original row, so "evidência referencia
// versão da competência avaliada" holds forever, and Restrict on the FK
// means a competency can never be hard-deleted out from under existing
// evidence ("evidência não é apagada quando currículo muda").
model EvidenceSubmission {
  achievementReviews LearnerCompetencyAchievementReview[]
  id                String                   @id @default(uuid()) @db.Uuid
  familyId          String                   @map("family_id") @db.Uuid
  learnerId         String                   @map("learner_id") @db.Uuid
  evidenceTypeId    String                   @map("evidence_type_id") @db.Uuid
  authorId          String                   @map("author_id") @db.Uuid
  textContent       String?                  @map("text_content")
  fileUrl           String?                  @map("file_url")
  storageKey        String?                  @unique @map("storage_key")
  mimeType          String?                  @map("mime_type")
  fileSizeBytes     Int?                     @map("file_size_bytes")
  checksumSha256    String?                  @map("checksum_sha256")
  validationStatus  EvidenceValidationStatus @default(UNVALIDATED) @map("validation_status")
  validatedByUserId String?                  @map("validated_by_user_id") @db.Uuid
  validatedAt       DateTime?                @map("validated_at") @db.Timestamptz
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  family            Family                         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner           Learner                        @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  evidenceType      EvidenceTypeDefinition         @relation(fields: [evidenceTypeId], references: [id], onDelete: Restrict)
  author            User                           @relation("EvidenceSubmissionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  validatedBy       User?                          @relation("EvidenceSubmissionValidator", fields: [validatedByUserId], references: [id], onDelete: SetNull)
  competencies      EvidenceSubmissionCompetency[]
  assessmentResults AssessmentResult[]

  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([evidenceTypeId])
  @@map("evidence_submissions")
}

enum EvidenceValidationStatus {
  UNVALIDATED
  VALIDATED
  REJECTED

  @@map("evidence_validation_statuses")
}

model EvidenceSubmissionCompetency {
  id                     String   @id @default(uuid()) @db.Uuid
  evidenceSubmissionId   String   @map("evidence_submission_id") @db.Uuid
  competencyDefinitionId String   @map("competency_definition_id") @db.Uuid
  competencyVersion      Int      @map("competency_version")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  evidenceSubmission   EvidenceSubmission   @relation(fields: [evidenceSubmissionId], references: [id], onDelete: Cascade)
  competencyDefinition CompetencyDefinition @relation(fields: [competencyDefinitionId], references: [id], onDelete: Restrict)

  @@unique([evidenceSubmissionId, competencyDefinitionId])
  @@index([evidenceSubmissionId])
  @@index([competencyDefinitionId])
  @@map("evidence_submission_competencies")
}

// Assessment result (issue #96 Fase 2, section 10's last item: "resultado
// guarda qual versão foi usada"). Same reasoning as
// EvidenceSubmissionCompetency: rubricDefinitionId pins the exact
// version row (Restrict, never hard-deletable out from under a result),
// plus a denormalized rubricVersion int. Can stand alone (no evidence)
// for e.g. a pure self-assessment -- evidenceSubmissionId is nullable.
// `assessorType` is free-form (SELF/PARENT/MENTOR/...), reusing the same
// "not a closed enum" philosophy already established for
// RubricDefinition.metadata.assessmentModes, not the literal schema -- a
// new assessor role is a data value, not a migration.
model AssessmentResult {
  id                   String   @id @default(uuid()) @db.Uuid
  familyId             String   @map("family_id") @db.Uuid
  learnerId            String   @map("learner_id") @db.Uuid
  evidenceSubmissionId String?  @map("evidence_submission_id") @db.Uuid
  rubricDefinitionId   String   @map("rubric_definition_id") @db.Uuid
  rubricVersion        Int      @map("rubric_version")
  assessorType         String   @map("assessor_type")
  assessorUserId       String?  @map("assessor_user_id") @db.Uuid
  notes                String?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  family             Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner            Learner                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  evidenceSubmission EvidenceSubmission?     @relation(fields: [evidenceSubmissionId], references: [id], onDelete: Restrict)
  rubricDefinition   RubricDefinition        @relation(fields: [rubricDefinitionId], references: [id], onDelete: Restrict)
  assessor           User?                   @relation("AssessmentResultAssessor", fields: [assessorUserId], references: [id], onDelete: SetNull)
  scores             AssessmentResultScore[]

  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([evidenceSubmissionId])
  @@index([rubricDefinitionId])
  @@map("assessment_results")
}

model AssessmentResultScore {
  id                 String   @id @default(uuid()) @db.Uuid
  assessmentResultId String   @map("assessment_result_id") @db.Uuid
  rubricCriterionId  String   @map("rubric_criterion_id") @db.Uuid
  score              Float
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  assessmentResult AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)
  rubricCriterion  RubricCriterion  @relation(fields: [rubricCriterionId], references: [id], onDelete: Restrict)

  @@unique([assessmentResultId, rubricCriterionId])
  @@index([assessmentResultId])
  @@index([rubricCriterionId])
  @@map("assessment_result_scores")
}

// Issue #126 item 3: this is the missing link that makes a
// CurriculumDefinition's bundled competencies into a family's actual
// per-learner working set. Before this table, "applying a curriculum"
// meant nothing at the competency level -- CurriculumService.applyTemplate
// only ever created old-style Subject/LearningObjective rows, even when
// resolving a catalog-based pedagogical_model_definition. Activating a
// CurriculumDefinition for a learner (via a new endpoint) fans out over
// its CurriculumDefinitionCompetency joins and inserts one row per
// competency here -- this is the per-learner tracking list that the new
// EvidenceSubmission/AssessmentResult flow (Fase 2) is actually assessed
// against, replacing LearningObjective/LearningRecord as the forward-going
// mechanism (per the human's explicit decision that Fase 2 replaces the
// Diario de Aprendizagem, not coexists with it).
//
// Same version-snapshot discipline as EvidenceSubmissionCompetency /
// AssessmentResult: competencyVersion is denormalized from the exact
// CompetencyDefinition row referenced (Restrict, so a competency can never
// be deleted out from under an active tracking row), so a later version
// bump of the competency does not retroactively change what a learner was
// actually assigned. curriculumDefinitionId is nullable and SetNull on
// delete -- a competency can, in principle, be tracked ad hoc for a
// learner without going through a curriculum (e.g. added individually by
// a parent), so the curriculum link is provenance, not a hard requirement.
model LearnerCompetencyTracking {
  progressionPolicyId String? @map("progression_policy_id") @db.Uuid
  policyVersion Int? @map("policy_version")
  progressionPolicy ProgressionPolicy? @relation(fields: [progressionPolicyId], references: [id], onDelete: Restrict)
  achievement LearnerCompetencyAchievement?
  id                     String                          @id @default(uuid()) @db.Uuid
  familyId               String                          @map("family_id") @db.Uuid
  learnerId              String                          @map("learner_id") @db.Uuid
  competencyDefinitionId String                          @map("competency_definition_id") @db.Uuid
  competencyVersion      Int                             @map("competency_version")
  curriculumDefinitionId String?                         @map("curriculum_definition_id") @db.Uuid
  status                 LearnerCompetencyTrackingStatus @default(ACTIVE)
  activatedAt            DateTime                        @default(now()) @map("activated_at") @db.Timestamptz
  retiredAt              DateTime?                       @map("retired_at") @db.Timestamptz
  createdAt              DateTime                        @default(now()) @map("created_at") @db.Timestamptz

  family               Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  learner              Learner               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  competencyDefinition CompetencyDefinition  @relation(fields: [competencyDefinitionId], references: [id], onDelete: Restrict)
  curriculumDefinition CurriculumDefinition? @relation(fields: [curriculumDefinitionId], references: [id], onDelete: SetNull)

  @@unique([learnerId, competencyDefinitionId, competencyVersion])
  @@index([familyId])
  @@index([familyId, learnerId])
  @@index([competencyDefinitionId])
  @@index([curriculumDefinitionId])
  @@map("learner_competency_tracking")
}

// Append-only awards: one award per exact tracking, never revoked or replaced.
model LearnerCompetencyAchievement {
  id String @id @default(uuid()) @db.Uuid
  trackingId String @unique @map("tracking_id") @db.Uuid
  familyId String @map("family_id") @db.Uuid
  learnerId String @map("learner_id") @db.Uuid
  competencyDefinitionId String @map("competency_definition_id") @db.Uuid
  competencyVersion Int @map("competency_version")
  curriculumDefinitionId String? @map("curriculum_definition_id") @db.Uuid
  curriculumVersion Int? @map("curriculum_version")
  progressionPolicyId String @map("progression_policy_id") @db.Uuid
  policyVersion Int @map("policy_version")
  validatedEvidenceCount Int @map("validated_evidence_count")
  minimumEvidenceCount Int @map("minimum_evidence_count")
  evidenceSnapshot Json @map("evidence_snapshot")
  awardedByUserId String @map("awarded_by_user_id") @db.Uuid
  achievedAt DateTime @default(now()) @map("achieved_at") @db.Timestamptz

  tracking LearnerCompetencyTracking @relation(fields: [trackingId], references: [id], onDelete: Restrict)
  family Family @relation(fields: [familyId], references: [id], onDelete: Restrict)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  competencyDefinition CompetencyDefinition @relation(fields: [competencyDefinitionId], references: [id], onDelete: Restrict)
  curriculumDefinition CurriculumDefinition? @relation(fields: [curriculumDefinitionId], references: [id], onDelete: Restrict)
  progressionPolicy ProgressionPolicy @relation(fields: [progressionPolicyId], references: [id], onDelete: Restrict)
  awardedBy User @relation(fields: [awardedByUserId], references: [id], onDelete: Restrict)
  reviews LearnerCompetencyAchievementReview[]

  @@index([familyId, learnerId])
  @@map("learner_competency_achievements")
}

// Rejection appends a review event; the original award remains unchanged.
model LearnerCompetencyAchievementReview {
  id String @id @default(uuid()) @db.Uuid
  achievementId String @map("achievement_id") @db.Uuid
  familyId String @map("family_id") @db.Uuid
  learnerId String @map("learner_id") @db.Uuid
  evidenceSubmissionId String @map("evidence_submission_id") @db.Uuid
  reviewedByUserId String @map("reviewed_by_user_id") @db.Uuid
  reason String @default("EVIDENCE_REJECTED")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  achievement LearnerCompetencyAchievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  family Family @relation(fields: [familyId], references: [id], onDelete: Restrict)
  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Restrict)
  evidenceSubmission EvidenceSubmission @relation(fields: [evidenceSubmissionId], references: [id], onDelete: Restrict)
  reviewedBy User @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([achievementId, evidenceSubmissionId])
  @@index([familyId, learnerId])
  @@map("learner_competency_achievement_reviews")
}

enum LearnerCompetencyTrackingStatus {
  ACTIVE
  RETIRED

  @@map("learner_competency_tracking_statuses")
}

// Bible translation registry (issue #96 Fase 3, section 16) --
// METADATA ONLY. This table records which translations exist and their
// properties; it never stores the actual scriptural text. Real passage
// text is fetched live from YouVersion's API on demand
// (YouVersionService.fetchPassage) and never persisted -- "texto bíblico
// é desacoplado da aplicação" holds by construction, since there is
// literally no text-content column here to decouple.
//
// `youVersionId` is the numeric id YouVersion's API expects (e.g.
// "1608" for Almeida Revista e Atualizada) -- kept as a plain string
// since that's exactly the type YouVersionService.fetchPassage already
// takes. `code` is the human-facing abbreviation (e.g. "ARA"), matching
// this codebase's existing Definition/Version code convention.
// `translationPhilosophy` is free-form (equivalência formal/funcional/
// dinâmica/paráfrase, or anything not yet named), not a closed enum, per
// this issue's own anti-hardcode principle. "Disponibilidade pode ser
// ativada/desativada" (section 16) reuses the existing DRAFT/PUBLISHED/
// DEPRECATED/ARCHIVED lifecycle rather than a separate toggle field --
// PUBLISHED is available, DEPRECATED/ARCHIVED is not, exactly like every
// other Definition/Version table.
//
// This is the strangler-fig proof step (like PR #98 for
// PedagogicalModelDefinition): it proves this table can represent the
// same catalog `apps/api/src/modules/devotional/infrastructure/
// youversion.service.ts`'s hardcoded `POPULAR_BIBLE_VERSIONS` array
// already provides. That array is NOT removed or cut over to read from
// here in this PR -- same reason every prior strangler-fig proof step in
// this project has kept the old path alive until a separate,
// human-approved cutover.
model BibleTranslationDefinition {
  id                    String           @id @default(uuid()) @db.Uuid
  code                  String
  version               Int              @default(1)
  status                DefinitionStatus @default(DRAFT)
  schemaVersion         String           @default("1.0.0") @map("schema_version")
  name                  String
  language              String
  youVersionId          String           @map("you_version_id")
  translationPhilosophy String?          @map("translation_philosophy")
  publisher             String?
  licensingNotes        String?          @map("licensing_notes")
  metadata              Json             @default("{}")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt           DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt          DateTime?        @map("deprecated_at") @db.Timestamptz

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@index([youVersionId])
  @@map("bible_translation_definitions")
}

// Curriculum pack (issue #96 Fase 4, section 27): a bundle/portability
// concept, not a new content type -- every individual definition table a
// pack would bundle already exists (LearningDomain, CompetencyDefinition,
// LearningPath, SkillDefinition, RubricDefinition, EvidenceTypeDefinition,
// ActivityDefinition, CurriculumDefinition, PedagogicalModelDefinition,
// TheologicalTraditionDefinition/TheologicalPositionDefinition,
// BibleTranslationDefinition). A pack itself follows the same
// Definition/Version pattern as everything else. Its manifest
// (CurriculumPackItem) is a real join table listing which
// (definitionType, code, version) tuples belong to the pack -- not an
// array of IDs, since the whole point of a pack is to be portable across
// databases where IDs won't match (section 28). Packs reference other
// packs they depend on (CurriculumPackDependency) by (code, version)
// value, not a hard FK -- a dependency may legitimately not exist yet in
// this database (that's exactly what import's "missing dependency"
// detection checks for).
model CurriculumPack {
  id            String           @id @default(uuid()) @db.Uuid
  code          String
  version       Int              @default(1)
  status        DefinitionStatus @default(DRAFT)
  schemaVersion String           @default("1.0.0") @map("schema_version")
  name          String
  description   String?
  metadata      Json             @default("{}")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz
  deprecatedAt  DateTime?        @map("deprecated_at") @db.Timestamptz

  items           CurriculumPackItem[]
  dependencies    CurriculumPackDependency[]
  familyInstances FamilyCurriculumPack[]

  @@unique([code, version])
  @@index([code])
  @@index([status])
  @@map("curriculum_packs")
}

// A family-owned, editable snapshot of a published platform pack. The
// portable document is copied at installation time so later platform pack
// versions cannot mutate a family's plan. `sourcePackCode` and
// `sourcePackVersion` remain denormalized provenance even if the source row
// is eventually retired.
model FamilyCurriculumPack {
  id                String   @id @default(uuid()) @db.Uuid
  familyId          String   @map("family_id") @db.Uuid
  sourcePackId      String   @map("source_pack_id") @db.Uuid
  sourcePackCode    String   @map("source_pack_code")
  sourcePackVersion Int      @map("source_pack_version")
  revision          Int      @default(1)
  document          Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  family     Family                         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  sourcePack CurriculumPack                 @relation(fields: [sourcePackId], references: [id], onDelete: Restrict)
  revisions  FamilyCurriculumPackRevision[]
  media      FamilyCurriculumPackMedia[]

  @@unique([familyId, sourcePackId], name: "family_curriculum_packs_family_source_unique")
  @@index([familyId])
  @@index([sourcePackCode, sourcePackVersion])
  @@map("family_curriculum_packs")
}

enum FamilyCurriculumPackMediaType {
  IMAGE
  VIDEO
  DOCUMENT

  @@map("family_curriculum_pack_media_types")
}

enum FamilyCurriculumPackMediaSourceType {
  UPLOAD
  EXTERNAL_URL

  @@map("family_curriculum_pack_media_source_types")
}

model FamilyCurriculumPackMedia {
  id                     String                              @id @default(uuid()) @db.Uuid
  familyCurriculumPackId String                              @map("family_curriculum_pack_id") @db.Uuid
  mediaType              FamilyCurriculumPackMediaType      @map("media_type")
  sourceType             FamilyCurriculumPackMediaSourceType @map("source_type")
  provider               String?
  title                  String
  description            String?
  url                    String?
  storageKey             String?                             @map("storage_key")
  mimeType               String?                             @map("mime_type")
  sizeBytes              Int?                                @map("size_bytes")
  createdAt              DateTime                            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                            @updatedAt @map("updated_at") @db.Timestamptz

  familyCurriculumPack FamilyCurriculumPack @relation(fields: [familyCurriculumPackId], references: [id], onDelete: Cascade)

  @@index([familyCurriculumPackId, createdAt])
  @@map("family_curriculum_pack_media")
}

// Append-only history for family edits. Keeping every document revision
// makes customization auditable and allows achievement snapshots to point
// back to the exact family curriculum state used at the time.
model FamilyCurriculumPackRevision {
  id                     String   @id @default(uuid()) @db.Uuid
  familyCurriculumPackId String   @map("family_curriculum_pack_id") @db.Uuid
  revision               Int
  document               Json
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  familyCurriculumPack FamilyCurriculumPack @relation(fields: [familyCurriculumPackId], references: [id], onDelete: Cascade)

  @@unique([familyCurriculumPackId, revision], name: "family_curriculum_pack_revisions_pack_revision_unique")
  @@index([familyCurriculumPackId, revision])
  @@map("family_curriculum_pack_revisions")
}

model CurriculumPackItem {
  id             String   @id @default(uuid()) @db.Uuid
  packId         String   @map("pack_id") @db.Uuid
  definitionType String   @map("definition_type")
  code           String
  version        Int
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  pack CurriculumPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, definitionType, code, version])
  @@index([packId])
  @@map("curriculum_pack_items")
}

// Soft reference by (code, version) value -- deliberately NOT a hard FK
// to another CurriculumPack row, since a dependency can be declared
// before (or without ever having) the depended-on pack present locally.
model CurriculumPackDependency {
  id               String   @id @default(uuid()) @db.Uuid
  packId           String   @map("pack_id") @db.Uuid
  dependsOnCode    String   @map("depends_on_code")
  dependsOnVersion Int      @map("depends_on_version")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  pack CurriculumPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, dependsOnCode, dependsOnVersion])
  @@index([packId])
  @@map("curriculum_pack_dependencies")
}
