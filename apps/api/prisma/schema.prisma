generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OutboxMessage {
  id             String    @id @db.Uuid
  eventType      String    @map("event_type")
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  attempts       Int       @default(0)
  idempotencyKey String    @unique @map("idempotency_key")

  @@map("outbox_messages")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String         @map("password_hash")
  fullName     String         @map("full_name")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  memberships  FamilyMember[]

  @@map("users")
}

model Family {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  countryCode   String             @map("country_code")
  stateProvince String?            @map("state_province")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  members       FamilyMember[]
  invitations   FamilyInvitation[]
  learners      Learner[]

  @@map("families")
}

enum EducationalStage {
  EARLY_YEARS
  PRIMARY_GRAMMAR
  MIDDLE_LOGIC
  HIGH_RHETORIC
  OTHER

  @@map("educational_stages")
}

model Learner {
  id           String           @id @default(uuid()) @db.Uuid
  familyId     String           @map("family_id") @db.Uuid
  firstName    String           @map("first_name")
  lastName     String?          @map("last_name")
  preferredName String?         @map("preferred_name")
  birthDate    DateTime         @map("birth_date") @db.Date
  stage        EducationalStage @default(PRIMARY_GRAMMAR)
  customGrade  String?          @map("custom_grade")
  avatarColor  String?          @map("avatar_color")
  specialNeeds String?          @map("special_needs")
  notes        String?
  archivedAt   DateTime?        @map("archived_at") @db.Timestamptz
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([familyId, archivedAt])
  @@map("learners")
}


model FamilyMember {
  id        String   @id @default(uuid()) @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId], name: "family_members_family_user_unique")
  @@index([userId])
  @@index([familyId])
  @@map("family_members")
}

model FamilyInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  email      String
  role       String
  token      String    @unique
  invitedBy  String    @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([email])
  @@index([token])
  @@map("family_invitations")
}
