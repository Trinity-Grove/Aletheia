{
  "name": "@aletheia/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "retention:purge-portfolio": "node dist/scripts/purge-expired-portfolio-items.js",
    "seed:pedagogical-models": "node dist/scripts/seed-pedagogical-model-definitions.js",
    "seed:evidence-types": "node dist/scripts/seed-evidence-type-definitions.js",
    "seed:bible-translations": "node dist/scripts/seed-bible-translation-definitions.js",
    "seed:biblical-formation": "node dist/scripts/seed-biblical-formation.js",
    "seed:biblical-formation-intermediate": "node dist/scripts/seed-biblical-formation-intermediate.js",
    "seed:music-formation": "node dist/scripts/seed-music-formation.js",
    "seed:music-instruments": "node dist/scripts/seed-music-instruments.js",
    "seed:music-christian": "node dist/scripts/seed-music-christian.js",
    "seed:trades-formation": "node dist/scripts/seed-trades-formation.js",
    "seed:cooking-formation": "node dist/scripts/seed-cooking-formation.js",
    "seed:cooking-progression": "node dist/scripts/seed-cooking-progression.js",
    "seed:cooking-life-skills": "node dist/scripts/seed-cooking-life-skills.js",
    "seed:gardening-formation": "node dist/scripts/seed-gardening-formation.js",
    "seed:gardening-production": "node dist/scripts/seed-gardening-production.js",
    "seed:gardening-management-planning": "node dist/scripts/seed-gardening-management-planning.js",
    "seed:home-sufficiency-foundations": "node dist/scripts/seed-home-sufficiency-foundations.js",
    "seed:personal-finance-foundations": "node dist/scripts/seed-personal-finance-foundations.js",
    "seed:resilience-formation": "node dist/scripts/seed-resilience-formation.js",
    "seed:resilience-navigation-camping": "node dist/scripts/seed-resilience-navigation-camping.js",
    "seed:resilience-water-fire": "node dist/scripts/seed-resilience-water-fire.js",
    "seed:resilience-real-emergencies": "node dist/scripts/seed-resilience-real-emergencies.js",
    "seed:physical-formation": "node dist/scripts/seed-physical-formation.js",
    "seed:technology-formation": "node dist/scripts/seed-technology-formation.js",
    "seed:vocation-formation": "node dist/scripts/seed-vocation-formation.js",
    "seed:math-subject": "node dist/scripts/seed-math-subject.js",
    "seed:science-subject": "node dist/scripts/seed-science-subject.js",
    "seed:history-subject": "node dist/scripts/seed-history-subject.js",
    "seed:geography-subject": "node dist/scripts/seed-geography-subject.js",
    "seed:language-subjects": "node dist/scripts/seed-language-subjects.js",
    "seed:trades-woodworking-construction": "node dist/scripts/seed-trades-woodworking-construction.js",
    "seed:trades-textile-craft": "node dist/scripts/seed-trades-textile-craft.js",
    "seed:trades-mechanical-electrical-home": "node dist/scripts/seed-trades-mechanical-electrical-home.js",
    "seed:arts-formation": "node dist/scripts/seed-arts-formation.js",
    "seed:service-community-formation": "node dist/scripts/seed-service-community-formation.js",
    "seed:foundational-curriculum": "node dist/scripts/seed-foundational-curriculum.js",
    "lint": "eslint . --config ../../packages/eslint-config/index.mjs --ignore-pattern dist --global require --global module",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "pretest": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "test": "jest --runInBand",
    "pretest:e2e": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "pretest:integration": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "pretypecheck": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aletheia/contracts": "workspace:*",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "fastify": "5.12.1",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.5.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.2.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@aletheia/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    }
  }
}
