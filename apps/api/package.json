{
  "name": "@aletheia/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint . --config ../../packages/eslint-config/index.mjs --ignore-pattern dist --global require --global module",
    "prisma": "prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "pretest": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "test": "jest --runInBand",
    "pretest:e2e": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "pretest:integration": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "pretypecheck": "pnpm --filter @aletheia/contracts build && pnpm run prisma:generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aletheia/contracts": "workspace:*",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "^6.19.3",
    "fastify": "5.12.1",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.2.1",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@aletheia/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    }
  }
}
