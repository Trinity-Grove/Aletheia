{
  "name": "@aletheia/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "prebuild": "pnpm --filter @aletheia/contracts build",
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "eslint src test --config ../../packages/eslint-config/index.mjs",
    "start": "node dist/main.js",
    "pretest": "pnpm --filter @aletheia/contracts build",
    "test": "jest --runInBand",
    "pretest:ci": "pnpm --filter @aletheia/contracts build",
    "test:ci": "jest --runInBand --ci",
    "pretest:e2e": "pnpm --filter @aletheia/contracts build",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "pretypecheck": "pnpm --filter @aletheia/contracts build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aletheia/contracts": "workspace:*",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "^6.19.3",
    "fastify": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "jest": {
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    }
  }
}
