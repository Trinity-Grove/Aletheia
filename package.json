{
  "name": "aletheia",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": { "node": ">=24.18.1 <25" },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @aletheia/web --filter @aletheia/api dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm -r --if-present test:ci",
    "check:boundaries": "node scripts/check-module-boundaries.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
