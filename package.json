{
  "name": "aletheia",
  "private": true,
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:boundaries": "node --test scripts/check-module-boundaries.test.mjs && node scripts/check-module-boundaries.mjs",
    "dev": "pnpm --parallel --filter @aletheia/web --filter @aletheia/api dev",
    "lint": "pnpm -r --if-present lint",
    "prisma:generate": "pnpm --filter @aletheia/api prisma:generate",
    "test:clean-typegen": "node --test scripts/web-typecheck-clean.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:ci": "pnpm -r --if-present test",
    "test:distribution": "node --test scripts/api-distribution.test.mjs",
    "verify": "pnpm prisma:generate && pnpm check:boundaries && pnpm lint && pnpm test:clean-typegen && pnpm typecheck && pnpm test:ci && pnpm --filter @aletheia/api test:e2e && pnpm test:distribution && pnpm build"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
